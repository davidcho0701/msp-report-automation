# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올리지 않는다.

# Cloud Insight REST 호출용 (CLI 는 ncloud configure 에 등록된 키를 사용)
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=

# 메일 발송 방식: smtp(기본) | outlook
#  outlook: 이 PC 의 클래식 Outlook 으로 발송 (SMTP 로그인 불필요. 해당 계정이 클래식 Outlook 에 설정돼 있어야 함)
MAIL_TRANSPORT=smtp

# SMTP (MAIL_TRANSPORT=smtp 일 때만 사용. 보내는 사람 주소/이름은 웹 UI > 전체 설정)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 메일 모드: dryrun(기본, .eml 파일로만 저장) | live(실제 발송)
# 운영자 점검 메일과 고객사 메일을 따로 켤 수 있다. 처음에는 운영자만 live 로 시험할 것.
MAIL_MODE_OPERATOR=dryrun
MAIL_MODE_CUSTOMER=dryrun
